# Plain HTTP container for Cloud Run; run Alembic separately with the same image.
FROM python:3.12.10-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:$PATH"

COPY --from=ghcr.io/astral-sh/uv:0.6.17 /uv /bin/uv

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,id=spry-cloudrun-uv,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project
RUN groupadd --system spry && useradd --system --gid spry spry

COPY app ./app
COPY alembic.ini ./
COPY alembic ./alembic

ENV PORT=8080
USER spry
EXPOSE 8080
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port \"${PORT}\""]
