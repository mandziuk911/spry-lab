# Public Cognito configuration is REQUIRED, locally and in production.
# After the reviewed auth stack exists, `make auth-config` writes these values
# to ignored .env from AWS outputs. No secrets are needed to run the app.
COGNITO_ISSUER=
COGNITO_CLIENT_ID=
# Full HTTPS origin, not just hostname.
COGNITO_DOMAIN=

# Optional LOCAL database overrides.
POSTGRES_USER=spry
POSTGRES_PASSWORD=spry
POSTGRES_DB=spry

# Never put AWS keys, Google OAuth secret or production DB passwords in app env.
# Private Google OAuth JSON belongs in ~/.local/state/spry-aws/google-oauth.json
# with permissions 0600; deployment tooling passes it only as a NoEcho parameter.
